# Resend API key, from https://resend.com/api-keys. Set this in the Vercel dashboard
# (Project > Settings > Environment Variables) as well, or the contact form cannot send.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=wearebezikee@gmail.com

# Sender address, overriding the default of Bezikee <hello@bezikee.com>. Must be on a
# domain verified in Resend.
# CONTACT_FROM_EMAIL=Bezikee <hello@bezikee.com>

# ------------------------------------------------------------------ admin panel
# Everything below powers bezikee.com/admin and demo.bezikee.com. See docs/ADMIN.md.

# Postgres. In production, Neon's *pooled* connection string. Locally, a local
# database, or the production one if you want to generate demo sites against it.
DATABASE_URL=postgres://localhost:5432/bezikee_admin

# Shared password for /admin. Leave empty locally to skip the login screen; in
# production the panel refuses to serve without it. Generate one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Google Maps Places API key (Places API (New)). Needed to scrape and to build
# demo sites; the panel works without one otherwise.
GOOGLE_MAPS_API_KEY=

# Where demo sites are published. Links are ${DEMO_BASE_URL}/<uuid>.
# Production default: https://demo.bezikee.com. For local development, Chrome and
# Firefox resolve *.localhost to your machine with no setup:
# DEMO_BASE_URL=http://demo.localhost:3000

# Pitch emails sent from a lead's page go through Resend with the key above.
# Resend can only send from a verified domain, so they go out from bezikee.com
# with replies routed to the Gmail inbox, and a BCC'd copy lands there too.
# OUTREACH_FROM_EMAIL=Bezikee <hello@bezikee.com>
# OUTREACH_REPLY_TO=wearebezikee@gmail.com
# OUTREACH_BCC=wearebezikee@gmail.com   (set empty to stop the copies)

# Optional: debug | info | warn | error. Defaults to info.
# LOG_LEVEL=info
