# Resend API key, from https://resend.com/api-keys. Set this in the Vercel dashboard
# (Project > Settings > Environment Variables) as well, or the contact form cannot send.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=wearebezikee@gmail.com

# Sender address. Must be on a domain verified in Resend; until bezikee.com is verified,
# leave this unset and Resend's shared onboarding@resend.dev sender is used.
# CONTACT_FROM_EMAIL=Bezikee <hello@bezikee.com>
